{
  "log": {"loglevel": "warning"},
  "dns": {
    "servers": [
      "https://1.1.1.1/dns-query",
      "https://8.8.8.8/dns-query"
    ],
    "queryStrategy": "UseIP"
  },
  "inbounds": [
    {
      "tag": "socks-in",
      "listen": "127.0.0.1",
      "port": 10808,
      "protocol": "socks",
      "settings": {"udp": true, "auth": "noauth"},
      "sniffing": {"enabled": true, "destOverride": ["http", "tls", "quic"]}
    },
    {
      "tag": "http-in",
      "listen": "127.0.0.1",
      "port": 10809,
      "protocol": "http",
      "settings": {},
      "sniffing": {"enabled": true, "destOverride": ["http", "tls", "quic"]}
    }
  ],
  "outbounds": [
    {
      "tag": "VPN Wi-fi meeyota",
      "protocol": "vless",
      "settings": {
        "vnext": [
          {
            "address": "wifi-test-1.example.com",
            "port": 443,
            "users": [
              {
                "id": "33333333-3333-3333-3333-333333333333",
                "encryption": "none"
              }
            ]
          }
        ]
      },
      "streamSettings": {
        "network": "ws",
        "security": "tls",
        "tlsSettings": {
          "serverName": "wifi-test-1.example.com",
          "allowInsecure": false
        },
        "wsSettings": {"path": "/wifipath"}
      }
    },
    {
      "tag": "proxy-1",
      "protocol": "vless",
      "settings": {
        "vnext": [
          {
            "address": "wifi-test-2.example.com",
            "port": 443,
            "users": [
              {
                "id": "44444444-4444-4444-4444-444444444444",
                "encryption": "none",
                "flow": "xtls-rprx-vision"
              }
            ]
          }
        ]
      },
      "streamSettings": {
        "network": "tcp",
        "security": "reality",
        "realitySettings": {
          "serverName": "www.apple.com",
          "fingerprint": "safari",
          "publicKey": "BBBBBBBBBBBBBBBBBBBBBBBBBBBBBBBBBBBBBBBBBBB",
          "shortId": "cdcdcdcdcd"
        }
      }
    },
    {
      "tag": "proxy-2",
      "protocol": "trojan",
      "settings": {
        "servers": [
          {
            "address": "wifi-test-3.example.com",
            "port": 8443,
            "password": "wifi-trojan-password"
          }
        ]
      },
      "streamSettings": {
        "network": "tcp",
        "security": "tls",
        "tlsSettings": {
          "serverName": "wifi-test-3.example.com",
          "allowInsecure": false,
          "fingerprint": "chrome"
        }
      }
    },
    {
      "tag": "direct",
      "protocol": "freedom"
    },
    {
      "tag": "block",
      "protocol": "blackhole"
    }
  ],
  "routing": {
    "domainStrategy": "IPIfNonMatch",
    "domainMatcher": "hybrid",
    "rules": [
      {"type": "field", "ip": ["1.1.1.1", "8.8.8.8"], "outboundTag": "direct"},
      {"type": "field", "network": "tcp,udp", "balancerTag": "meeyota-auto"}
    ],
    "balancers": [
      {
        "tag": "meeyota-auto",
        "selector": ["VPN Wi-fi meeyota", "proxy-"],
        "strategy": {
          "type": "leastLoad",
          "settings": {
            "expected": 2,
            "maxRTT": "1s",
            "tolerance": 0.01,
            "baselines": ["300ms", "1s"]
          }
        },
        "fallbackTag": "direct"
      }
    ]
  },
  "burstObservatory": {
    "subjectSelector": ["VPN Wi-fi meeyota", "proxy-"],
    "pingConfig": {
      "destination": "http://www.google.com/generate_204",
      "connectivity": "http://www.google.com/generate_204",
      "interval": "60s",
      "sampling": 2,
      "timeout": "5s"
    }
  },
  "stats": {},
  "policy": {
    "levels": {
      "0": {"handshake": 2, "connIdle": 300, "uplinkOnly": 2, "downlinkOnly": 5}
    }
  }
}
