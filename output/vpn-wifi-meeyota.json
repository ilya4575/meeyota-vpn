{
  "log": {
    "loglevel": "warning"
  },
  "dns": {
    "servers": [
      "https://1.1.1.1/dns-query",
      "https://8.8.8.8/dns-query"
    ],
    "queryStrategy": "UseIP"
  },
  "inbounds": [
    {
      "tag": "socks-in",
      "listen": "127.0.0.1",
      "port": 10808,
      "protocol": "socks",
      "settings": {
        "udp": true,
        "auth": "noauth"
      },
      "sniffing": {
        "enabled": true,
        "destOverride": [
          "http",
          "tls",
          "quic"
        ]
      }
    },
    {
      "tag": "http-in",
      "listen": "127.0.0.1",
      "port": 10809,
      "protocol": "http",
      "settings": {},
      "sniffing": {
        "enabled": true,
        "destOverride": [
          "http",
          "tls",
          "quic"
        ]
      }
    }
  ],
  "outbounds": [
    {
      "tag": "VPN Wi-fi meeyota",
      "protocol": "vless",
      "settings": {
        "vnext": [
          {
            "address": "example.com",
            "port": 443,
            "users": [
              {
                "id": "cd3bb7d9-7df3-4644-ac05-c260990ac277",
                "encryption": "none"
              }
            ]
          }
        ]
      },
      "streamSettings": {
        "network": "tcp",
        "security": "tls",
        "tlsSettings": {
          "serverName": "cf.com",
          "fingerprint": "chrome"
        }
      }
    },
    {
      "tag": "proxy-1",
      "protocol": "trojan",
      "settings": {
        "servers": [
          {
            "address": "server2.com",
            "port": 443,
            "password": "pass"
          }
        ]
      },
      "streamSettings": {
        "network": "tcp",
        "security": "tls",
        "tlsSettings": {
          "serverName": "cf.com"
        }
      }
    },
    {
      "tag": "proxy-2",
      "protocol": "shadowsocks",
      "settings": {
        "servers": [
          {
            "address": "server3.com",
            "port": 8388,
            "method": "aes-256-gcm",
            "password": "password"
          }
        ]
      },
      "streamSettings": {
        "network": "tcp",
        "security": "none"
      }
    },
    {
      "tag": "direct",
      "protocol": "freedom"
    },
    {
      "tag": "block",
      "protocol": "blackhole"
    }
  ],
  "routing": {
    "domainStrategy": "IPIfNonMatch",
    "domainMatcher": "hybrid",
    "rules": [
      {
        "type": "field",
        "ip": [
          "1.1.1.1",
          "8.8.8.8"
        ],
        "outboundTag": "direct"
      },
      {
        "type": "field",
        "network": "tcp,udp",
        "balancerTag": "meeyota-auto"
      }
    ],
    "balancers": [
      {
        "tag": "meeyota-auto",
        "selector": [
          "VPN Wi-fi meeyota",
          "proxy-"
        ],
        "strategy": {
          "type": "leastLoad",
          "settings": {
            "expected": 2,
            "maxRTT": "1s",
            "tolerance": 0.01,
            "baselines": [
              "300ms",
              "1s"
            ]
          }
        },
        "fallbackTag": "direct"
      }
    ]
  },
  "burstObservatory": {
    "subjectSelector": [
      "VPN Wi-fi meeyota",
      "proxy-"
    ],
    "pingConfig": {
      "destination": "http://www.google.com/generate_204",
      "connectivity": "http://www.google.com/generate_204",
      "interval": "60s",
      "sampling": 2,
      "timeout": "5s"
    }
  },
  "stats": {},
  "policy": {
    "levels": [
      {
        "handshake": 2,
        "connIdle": 300,
        "uplinkOnly": 2,
        "downlinkOnly": 5
      }
    ]
  }
}